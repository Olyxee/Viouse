OPENAI_API_KEY=
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
VISION_MODEL=gpt-4.1
PLANNER_MODEL=gpt-4.1
DATABASE_URL=sqlite:///./data/editor.db
DATA_DIR=./data
# Optional: private S3 bucket; local disk remains the worker cache.
S3_BUCKET=
S3_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Set true behind HTTPS in production.
COOKIE_SECURE=false
ALLOW_REGISTRATION=true
LOCAL_MODE=true
MAX_UPLOAD_MB=2048
MAX_PROJECT_MINUTES=60
